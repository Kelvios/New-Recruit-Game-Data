<?xml version="1.0" encoding="utf-8"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" library="false" id="f5eb-99bf-6530-ebf1" name="TRIBAL 2nd Edition - Core Warband" gameSystemId="sys-e140-121e-9b34-0be3" gameSystemRevision="1" revision="1" authorName="TRIBAL 2nd Edition rules by Mana Press. NR data authored privately for personal use." battleScribeVersion="2.03" type="catalogue">
  <sharedSelectionEntries>
    <selectionEntry type="upgrade" import="true" name="Short Weapon" hidden="false" id="2b57-61a5-dc4f-3c4c">
      <rules>
        <rule id="81d2-6d49-04e4-d635" name="Short Weapon" hidden="false">
          <description>Sword, axe, knife, club or similar. Gives the Preferred Weapon Bonus on Club Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Long Weapon" hidden="false" id="42a2-f93b-8d3e-c7b8">
      <rules>
        <rule id="b017-ac7e-647a-afc3" name="Long Weapon" hidden="false">
          <description>Spear, long-axe, pike, polearm or similar. Gives the Preferred Weapon Bonus on Spade Strike cards.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Adept (Veteran Skill)" hidden="false" id="efbc-dd42-6368-d42d">
      <rules>
        <rule id="80b6-48e3-6281-28bf" name="Adept" hidden="false">
          <description>After long training with their weapon of choice, this Unit has a Preferred Weapon Bonus of +2 instead of the normal +1. Cannot be combined with Champion or Duellist.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Agile (Veteran Skill)" hidden="false" id="a528-bd4d-626d-e364">
      <rules>
        <rule id="4c31-b884-8c84-2dd4" name="Agile" hidden="false">
          <description>The Unit always begins a combat round with Advantage, even if Charged. If both Units engaged in combat have this Skill, the Unit that made the Charge starts with Advantage as normal.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cunning (Veteran Skill)" hidden="false" id="8b94-6269-cb05-0977">
      <rules>
        <rule id="0aeb-9781-4200-61f7" name="Cunning" hidden="false">
          <description>This Unit adds +1 to its card value on any red (Hearts or Diamonds) Feint card played during an Exchange.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Deadly Shot (Veteran Skill)" hidden="false" id="5038-18bf-6ca9-258f">
      <rules>
        <rule id="8d12-c185-1416-49d8" name="Deadly Shot" hidden="false">
          <description>This Unit adds +2 to its card value when making ranged attacks. Normally only useful for Marksmen, or Characters with the Long Shot Skill.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Duellist (Veteran Skill)" hidden="false" id="0889-deae-b5be-5af0">
      <rules>
        <rule id="2c5d-1bd7-6568-838d" name="Duellist" hidden="false">
          <description>Characters only. Gains the Preferred Weapon Bonus from both Spade and Club Strike cards. Cannot be combined with Adept or Champion.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Elite Marksmen (Veteran Skill)" hidden="false" id="52e9-e22b-55e2-2dc8">
      <rules>
        <rule id="65cb-808d-2b7e-2d40" name="Elite Marksmen" hidden="false">
          <description>Marksmen only. This Unit is considered armed with either short or long weapons, and fights in combat as if it were Warriors.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Fearsome (Veteran Skill)" hidden="false" id="30c9-ad4d-dadb-fa9f">
      <rules>
        <rule id="77fb-42ba-8911-f2d6" name="Fearsome" hidden="false">
          <description>This Unit causes +1 hit with Spade or Club Strike cards when it wins an Exchange against a Formation.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Hard Target (Veteran Skill)" hidden="false" id="6089-9864-2ef7-8f62">
      <rules>
        <rule id="5f6b-a5a5-aff7-b998" name="Hard Target" hidden="false">
          <description>Marksmen firing at this Unit suffer -2 to their attack card value.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Long Shot (Veteran Skill)" hidden="false" id="ac7a-8179-b393-71e8">
      <rules>
        <rule id="9160-ac26-57d1-b8c2" name="Long Shot" hidden="false">
          <description>Characters only. This Character may use its Activation Card to make a ranged attack, resolved as a ranged attack from a Unit of Marksmen. Unlike Marksmen, if the target Unit is destroyed this way the player DOES receive Blood Payment.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Ranger (Veteran Skill)" hidden="false" id="fc9e-e47f-5ab8-7f30">
      <rules>
        <rule id="cf65-1aa3-59a8-8f09" name="Ranger" hidden="false">
          <description>This Unit is not slowed to a Walk when moving through Tough Going, and may Walk (1 short card-edge) across Impassable terrain if it can clear it in a single activation. Cannot be used by Cavalry.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Savage (Veteran Skill)" hidden="false" id="2463-a2e8-c81b-12c3">
      <rules>
        <rule id="2e1b-dfa5-854a-4d2c" name="Savage" hidden="false">
          <description>This Unit causes +1 hit with Spade or Club Strike cards when it wins an Exchange against a Character.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Survival Instinct (Veteran Skill)" hidden="false" id="f6a5-5676-4814-b80a">
      <rules>
        <rule id="97a3-7c19-be05-2c5c" name="Survival Instinct" hidden="false">
          <description>After winning an Exchange, this Unit may break off from combat instead of causing damage: it discards its remaining combat-hand cards and an equal number of the enemy's. The Unit still counts as having lost the combat round (it retreats and the enemy gains the reward).</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Tactician (Veteran Skill)" hidden="false" id="be2c-ce57-8c82-3eb6">
      <rules>
        <rule id="75ee-2e8d-a700-4470" name="Tactician" hidden="false">
          <description>Warlord only. Immediately after the setup phase, the player may reposition 1 enemy Hero or Formation anywhere within the opponent's setup zone.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Throwing Weapons (Veteran Skill)" hidden="false" id="75fd-1f36-0f05-07c8">
      <rules>
        <rule id="0445-29c2-fd5e-e40e" name="Throwing Weapons" hidden="false">
          <description>When this Unit Charges into close combat, flip a card: a black (Spade or Club) card causes 1 hit on the target before the Charge is resolved. Not increased by Strong.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Tough (Veteran Skill)" hidden="false" id="2f06-aa71-dede-707d">
      <rules>
        <rule id="cf2d-36ce-bd33-dd8e" name="Tough" hidden="false">
          <description>Characters only. This Character begins the game with +1 Wound. This extra Wound does not increase its combat hand size.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Curse (Veteran Skill)" hidden="false" id="529d-1dac-1dca-e397">
      <rules>
        <rule id="b31e-4222-9eb5-42fe" name="Curse" hidden="false">
          <description>Shaman only. After moving, the Shaman may target an enemy Unit within a long card-edge and flip a card: a black card removes that Unit's Activation Card for the turn. No effect on a Unit that has already activated this turn.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Divination (Veteran Skill)" hidden="false" id="6628-acda-0da0-c8d4">
      <rules>
        <rule id="6500-850a-9a49-6968" name="Divination" hidden="false">
          <description>Shaman only. Once per game, look at the top 6 cards of either or both players' draw decks (in any combination) and return them in the same order.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Healing (Veteran Skill)" hidden="false" id="f2bb-78e2-7e59-aed1">
      <rules>
        <rule id="cb77-8ab7-a41e-6933" name="Healing" hidden="false">
          <description>Shaman only. After moving, the Shaman may target a friendly Unit within a short card-edge and flip a card: a black card restores 1 Wound (or replaces 1 casualty figure in a Formation), never above the Unit's starting state.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rat Cunning (Veteran Skill)" hidden="false" id="bf00-af39-a176-b1e8">
      <rules>
        <rule id="f57c-49cd-d98d-8c9e" name="Rat Cunning" hidden="false">
          <description>Shaman only. Each turn, before initiative is determined, draw 2 cards from the shared deck, keep one concealed and declare whether to keep it or offer it to the opponent. Whoever ends up with the card must use it for turn initiative AND as one of their Activation Cards this turn.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Respected (Veteran Skill)" hidden="false" id="504f-998d-ec68-0610">
      <rules>
        <rule id="9ef7-8b11-0188-c510" name="Respected" hidden="false">
          <description>Warlord only. Card Pools optional rule only. At the start of the game, this Warlord's player draws 1 additional Card Pool card (6 total). Not lost if the Warlord is slain. Cannot be combined with Revered.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Berserker (Elite Skill)" hidden="false" id="7213-7fbb-e916-b944">
      <rules>
        <rule id="37b1-379f-0ee1-08af" name="Berserker" hidden="false">
          <description>Characters only. This Character always draws its combat hand as if completely unwounded. It suffers -2 to the value of any red (Hearts or Diamonds) Feint card it plays.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Champion (Elite Skill)" hidden="false" id="89b9-3a9e-e5ea-755a">
      <rules>
        <rule id="d7ff-85ed-9110-a02f" name="Champion" hidden="false">
          <description>Characters only. Preferred Weapon Bonus of +2 (instead of +1), plus a further +1 Preferred Weapon Bonus with the other Strike suit. Cannot be combined with Adept or Duellist.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Concealment (Elite Skill)" hidden="false" id="efc8-f150-5e3a-bb7c">
      <rules>
        <rule id="6abe-f366-76eb-bcb1" name="Concealment" hidden="false">
          <description>Warlord only. During deployment, this player's Units are represented by red (Hearts/Diamonds) cards placed face down: number cards for Formations, face cards for Characters, plus an equal number of black decoy cards. All are revealed and Units placed before the first turn.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Seasoned (Elite Skill)" hidden="false" id="4cab-e737-aa34-e7ba">
      <rules>
        <rule id="0d5b-6b73-2f97-5629" name="Seasoned" hidden="false">
          <description>This Unit may discard and redraw 2 cards from its combat hand before the first Exchange of a combat.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Strong (Elite Skill)" hidden="false" id="60fa-5d36-1da6-d22e">
      <rules>
        <rule id="b079-70b8-60e1-2b67" name="Strong" hidden="false">
          <description>Characters only. This Character causes +1 hit when it wins a hand-to-hand Exchange with a Spade or Club Strike card.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Evil Eye (Elite Skill)" hidden="false" id="a830-7429-c0f6-e0fc">
      <rules>
        <rule id="6dcc-c065-6b91-b28f" name="Evil Eye" hidden="false">
          <description>Shaman only. At the start of the Shaman's activation, mark one enemy Unit in line of sight. Once that turn, the Shaman's player may force that Unit to discard a just-played attack card and replace it with a card drawn at random.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Revered (Elite Skill)" hidden="false" id="b77a-fc3b-ab92-e833">
      <rules>
        <rule id="cd3d-ed5e-ee4e-7314" name="Revered" hidden="false">
          <description>Warlord only. Card Pools optional rule only. At the start of the game, this Warlord's player draws 2 additional Card Pool cards (7 total). Not lost if the Warlord is slain. Cannot be combined with Respected.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Light Armour (Historical Rule)" hidden="false" id="3ca3-c060-92bc-983f">
      <rules>
        <rule id="f91b-f5a1-655c-2a7f" name="Light Armour" hidden="false">
          <description>Equipment, 0.5 Honour Point per Unit (i.e. 1 Honour Point equips any 2 Units). When a Unit wearing armour suffers a hit, draw a card: 11+ cancels that hit (only one hit is ever cancelled this way, even from Overpower or multi-hit attacks). The Exchange still counts as lost for determining who won the combat round.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0.5"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Heavy Armour (Historical Rule)" hidden="false" id="6771-c2a0-b5dc-b475">
      <rules>
        <rule id="d14b-460a-aa9d-71bc" name="Heavy Armour" hidden="false">
          <description>Equipment, Characters only, 1 Honour Point per Unit. When this Character suffers a hit, draw a card: 8+ cancels that hit (only one hit is ever cancelled this way). The wearer is Slowed: when Sprinting, the second portion of the move is only a Walk (1 short card-edge).</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Assegai (the Short Stabbing Spear) (Historical Rule)" hidden="false" id="46d0-6fd0-9d79-083d">
      <rules>
        <rule id="88af-9f2f-43e7-a29e" name="Assegai (the Short Stabbing Spear)" hidden="false">
          <description>1 Honour Point per Unit. At the start of a combat round, after hands are dealt but before the first Exchange, the owning player declares whether this Unit is armed with short or long weapons for the round, and cannot change weapon type again until the next round.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Cavalry (Historical Rule)" hidden="false" id="0ff6-6347-c2ed-e65e">
      <rules>
        <rule id="2407-3bb1-913b-07c6" name="Cavalry" hidden="false">
          <description>1 Honour Point per Unit. The Unit is mounted: Walk 2 short card-edges, March 2 long card-edges, Sprint 4 long card-edges; may turn only once during a move. In Tough Going all distances are reduced from long to short card-edges and no Sprint is possible; Buildings are Impassable. May dismount permanently at the start of an activation.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Chariots (Historical Rule)" hidden="false" id="2eb5-d846-827b-b1da">
      <rules>
        <rule id="39c4-5489-72cc-5900" name="Chariots" hidden="false">
          <description>2 Honour Points, Warlord and Heroes only. Walk 2 short card-edges, March 2 long card-edges, Sprint 4 long card-edges; may turn only once, at the very start of the move. Never moves through Tough Going or Buildings (a forced move there dismounts the Unit permanently). Shock and Awe: if the Chariot charged after a March or Sprint move, it gets 1 extra combat card for that combat round.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="2"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Counting Coup (Historical Rule)" hidden="false" id="dd62-0160-ebe5-2523">
      <constraints>
        <constraint type="max" value="2" field="selections" scope="roster" shared="true" id="9fdf-9a9b-dd02-8e9d"/>
      </constraints>
      <rules>
        <rule id="e437-2e5f-8a8b-f34c" name="Counting Coup" hidden="false">
          <description>1 Honour Point per Unit, Warriors or Heroes only, maximum 2 Units in the warband. Winning Exchanges with black (Spade/Club) Strike cards count as wins but cause no hits. Winning a combat round also takes 1 Honour Point from the enemy's pool, in addition to the normal reward from the central supply.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Boasts – the Power of Words (Historical Rule, once per warband)" hidden="false" id="2e7d-71e3-4ee3-d425">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="f1fa-844f-727e-ff26"/>
      </constraints>
      <rules>
        <rule id="550d-314c-237b-f00d" name="Boasts – the Power of Words" hidden="false">
          <description>1 Honour Point, once per warband. After setup but before the first turn, each Boasting player secretly bids 1+ Honour Points. Winner loses their bid and draws 5 cards (used as Card Pool cards); loser loses their bid and draws 2; a tie means both lose their bid and draw 3 each. Not recommended together with Card Pools.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Raid from the Water (Historical Rule, once per warband)" hidden="false" id="27b7-5e0c-1bf2-f83b">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="f07e-4cb4-ab10-4592"/>
      </constraints>
      <rules>
        <rule id="3fb1-a3e1-9a39-204a" name="Raid from the Water" hidden="false">
          <description>1 Honour Point, once per warband. After both players set up but before the first turn, the raiding player may move ALL of their Units up to two long card-edges.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Stalking the Prey (Historical Rule, once per warband)" hidden="false" id="007e-bd85-9776-54c2">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="8d0a-187c-ef3a-5673"/>
      </constraints>
      <rules>
        <rule id="c108-d0b8-5c2c-4a40" name="Stalking the Prey" hidden="false">
          <description>1 Honour Point, once per warband. Before the game, draw 4 cards from the shared deck: black = a hidden Unit, red = a decoy (redraw if all 4 are red). Deploy them face down; each black card deployed keeps one Unit off-table in reserve. Revealed voluntarily, or when an enemy Charges or moves within 1 long card-edge of the card. Concealed cards act last each turn (Walk only, never within 1 long card-edge of an enemy). Cannot be used together with the Concealment Skill, and never applies to Cavalry or Chariots.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Trophy Hunters (Historical Rule, once per warband)" hidden="false" id="6781-2a63-9a28-b77d">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="a749-9055-421e-fc04"/>
      </constraints>
      <rules>
        <rule id="3c53-9d38-abe5-d020" name="Trophy Hunters" hidden="false">
          <description>1 Honour Point, once per warband. After destroying an enemy Unit in hand-to-hand combat, a Unit may spend its next entire activation Collecting Trophies to gain 1 Honour Point from the central supply. Lost if the Unit is Charged or otherwise loses its Activation Card first.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="War Dance (Historical Rule, once per warband)" hidden="false" id="7cfb-c955-e515-d741">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="c39c-6e43-7563-4688"/>
      </constraints>
      <rules>
        <rule id="bf36-4289-2deb-d897" name="War Dance" hidden="false">
          <description>1 Honour Point, once per warband. After setup but before the first turn, each War Dance player secretly bids 1+ Honour Points. Winner loses their bid and draws 5 cards; loser loses their bid and draws 2; a tie means both lose their bid and draw 3 each. Not recommended together with Card Pools.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="1"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="upgrade" import="true" name="Rally Around the Flag (Historical Rule, 1 Hero only)" hidden="false" id="8523-9815-59d5-3fd8">
      <constraints>
        <constraint type="max" value="1" field="selections" scope="roster" shared="true" id="28be-b942-2003-e274"/>
      </constraints>
      <rules>
        <rule id="af93-e155-3405-a2d6" name="Rally Around the Flag" hidden="false">
          <description>0 Honour Points, 1 Hero only. Until this standard-bearer is destroyed, any friendly Unit with a figure within 2 long card-edges of the flag (including the standard-bearer) never loses a combat round: instead their opponent must retreat as if losing, without gaining the Honour Point reward. If the standard-bearer falls in hand-to-hand combat the flag is captured (attach it to the winning Unit); it can be recaptured by destroying that Unit. If the flag ends the game in enemy hands, its owner loses 5 Honour Points.</description>
        </rule>
      </rules>
      <costs>
        <cost name="Honour" typeId="2583-462d-9a3d-8b99" value="0"/>
      </costs>
    </selectionEntry>
    <selectionEntry type="model" import="true" name="Warlord" hidden="false" id="2999-156f-8993-5a6c">
